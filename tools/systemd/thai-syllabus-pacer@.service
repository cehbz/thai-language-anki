[Unit]
Description=Thai syllabus quota pacer, deck %i

[Service]
Type=oneshot
# 3: nothing to do this tick (tools/quota_pacer.py's exit codes)
SuccessExitStatus=3
WorkingDirectory=%h/projects/thai-language-anki
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run python tools/quota_pacer.py --deck %h/decks/%i --require-measured
StandardOutput=append:%h/decks/%i/work/pacer.log
StandardError=append:%h/decks/%i/work/pacer.log
